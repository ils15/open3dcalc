{
  "name": "open3dcalc",
  "private": true,
  "version": "1.9.1",
  "main": "electron/dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev:desktop": "concurrently -n vite,electron \"vite --config vite.desktop.config.ts\" \"npm run dev:electron\"",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:electron": "tsc -p electron/tsconfig.json && node scripts/verify-electron-imports.mjs && cross-env NODE_ENV=development electron .",
    "build:shared": "tsc -p tsconfig.app.json --noEmit",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/verify-electron-imports.mjs",
    "build:all": "npm run build:desktop && npm run build:web",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify:electron": "node scripts/verify-electron-imports.mjs",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@react-pdf/renderer": "^4.0.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.0.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^1.16.0",
    "pantheon-opencode": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "recharts": "^2.0.0",
    "three": "^0.184.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "changelogen": "0.6.2",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
    "appId": "com.open3dcalc.desktop",
    "productName": "Open3DCalc",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/dist/**/*",
      "dist/**/*",
      "package.json",
      "db/migrations/*.sql"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
