{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open3dcalc.org/schemas/spec-01-manifest.schema.json",
  "title": "SPEC-01 Data Manifest Schema",
  "type": "object",
  "required": ["manifest_version", "policy_version", "keys"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifestEntry" }
    }
  },
  "$defs": {
    "surface": {
      "type": "string",
      "description": "Manifest's renderer-facing surface. When physical storage differs by platform, platform_destinations records the actual key and surface.",
      "enum": [
        "localStorage",
        "sqlite_storage_table",
        "sqlite_domain_tables",
        "indexeddb",
        "opfs",
        "cache_api",
        "appdata_files",
        "logs",
        "temp_staging",
        "snapshots",
        "memory"
      ]
    },
    "platform": {
      "type": "string",
      "enum": ["electron", "web", "pwa"]
    },
    "platformDestination": {
      "type": "object",
      "required": ["platform", "key", "surface"],
      "additionalProperties": false,
      "properties": {
        "platform": { "$ref": "#/$defs/platform" },
        "key": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" }
      }
    },
    "persistenceMode": {
      "type": "string",
      "enum": ["none", "memory_only", "plaintext_allowed"]
    },
    "syncMode": {
      "type": "string",
      "enum": ["never", "opt_in"]
    },
    "exportMode": {
      "type": "string",
      "enum": ["never", "user_export", "diagnostic_only"]
    },
    "erasureMode": {
      "type": "string",
      "enum": ["erase_on_delete_all", "retain_anonymized"]
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "user_content",
        "user_preference",
        "ui_state",
        "ui_preference",
        "onboarding_flag",
        "consent_record",
        "cache",
        "diagnostic",
        "snapshot",
        "ephemeral_key",
        "derived_analytics"
      ]
    },
    "legalBasis": {
      "type": "string",
      "enum": [
        "consent",
        "contract_performance",
        "legitimate_interest",
        "not_personal_data"
      ]
    },
    "plaintextPiiKey": {
      "type": "string",
      "enum": [
        "open3dcalc_customers_v1",
        "open3dcalc_quotes_v1",
        "open3dcalc_history_v2"
      ],
      "description": "The complete and exclusive Stable/Desktop plaintext-PII logical key scope approved by policy 1.9. Physical per-platform destinations are declared in platform_destinations."
    },
    "retentionPolicy": {
      "type": "string",
      "enum": ["user_controlled", "session_only", "fixed"]
    },
    "manifestEntry": {
      "type": "object",
      "required": [
        "key",
        "surface",
        "platforms",
        "class",
        "pii",
        "persistence",
        "sync",
        "export",
        "erasure",
        "retention",
        "purpose",
        "legal_basis",
        "owner",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "platform_destinations": {
          "type": "array",
          "description": "Physical per-platform destinations when a logical manifest key maps to a different platform-specific key or surface.",
          "items": { "$ref": "#/$defs/platformDestination" },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platform" },
          "minItems": 1,
          "uniqueItems": true
        },
        "class": { "$ref": "#/$defs/dataClass" },
        "pii": { "type": "boolean" },
        "persistence": { "$ref": "#/$defs/persistenceMode" },
        "sync": { "$ref": "#/$defs/syncMode" },
        "export": { "$ref": "#/$defs/exportMode" },
        "erasure": { "$ref": "#/$defs/erasureMode" },
        "retention": {
          "type": "object",
          "required": ["policy", "max_days"],
          "additionalProperties": false,
          "properties": {
            "policy": { "$ref": "#/$defs/retentionPolicy" },
            "max_days": { "type": "integer", "minimum": 0 }
          }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "legal_basis": { "$ref": "#/$defs/legalBasis" },
        "owner": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pii": { "const": true },
              "persistence": { "const": "plaintext_allowed" }
            },
            "required": ["pii", "persistence"]
          },
          "then": {
            "properties": {
              "key": { "$ref": "#/$defs/plaintextPiiKey" },
              "surface": { "const": "localStorage" },
              "platforms": { "const": ["electron", "web", "pwa"] },
              "class": { "const": "user_content" }
            },
            "required": ["platform_destinations"]
          }
        },
        {
          "if": {
            "properties": {
              "key": { "$ref": "#/$defs/plaintextPiiKey" }
            },
            "required": ["key"]
          },
          "then": {
            "properties": {
              "pii": { "const": true },
              "surface": { "const": "localStorage" },
              "platforms": { "const": ["electron", "web", "pwa"] },
              "class": { "const": "user_content" },
              "persistence": { "const": "plaintext_allowed" },
              "legal_basis": { "const": "contract_performance" }
            }
          }
        },
        {
          "if": {
            "properties": { "key": { "const": "open3dcalc_customers_v1" } },
            "required": ["key"]
          },
          "then": {
            "properties": {
              "platform_destinations": {
                "const": [
                  {
                    "platform": "electron",
                    "key": "open3dcalc_pwless_customers_v1",
                    "surface": "sqlite_storage_table"
                  },
                  {
                    "platform": "web",
                    "key": "open3dcalc_customers_v1",
                    "surface": "localStorage"
                  },
                  {
                    "platform": "pwa",
                    "key": "open3dcalc_customers_v1",
                    "surface": "localStorage"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "key": { "const": "open3dcalc_quotes_v1" } },
            "required": ["key"]
          },
          "then": {
            "properties": {
              "platform_destinations": {
                "const": [
                  {
                    "platform": "electron",
                    "key": "open3dcalc_pwless_quotes_v1",
                    "surface": "sqlite_storage_table"
                  },
                  {
                    "platform": "web",
                    "key": "open3dcalc_quotes_v1",
                    "surface": "localStorage"
                  },
                  {
                    "platform": "pwa",
                    "key": "open3dcalc_quotes_v1",
                    "surface": "localStorage"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "key": { "const": "open3dcalc_history_v2" } },
            "required": ["key"]
          },
          "then": {
            "properties": {
              "platform_destinations": {
                "const": [
                  {
                    "platform": "electron",
                    "key": "open3dcalc_pwless_history_v1",
                    "surface": "sqlite_storage_table"
                  },
                  {
                    "platform": "web",
                    "key": "open3dcalc_history_v2",
                    "surface": "localStorage"
                  },
                  {
                    "platform": "pwa",
                    "key": "open3dcalc_history_v2",
                    "surface": "localStorage"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
