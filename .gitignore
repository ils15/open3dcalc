# Dependencies
node_modules

# Build outputs
dist/
dist-web/
dist-ssr/
dist-electron/
electron/dist/
storybook-static/
coverage/

# Electron Builder release output
release/
*.blockmap

# Dev symlink (index.web.html → index.html for Vite dev server)
index.html

# Stale codebases — keep dirs but ignore their build artifacts
web/node_modules/
web/dist/
web/coverage/
web/storybook-static/
desktop/node_modules/
desktop/dist/
desktop/release/
desktop/*.db
desktop/*.db-shm
desktop/*.db-wal

# Compiled JS artifacts in db/ directories (have .ts sources)
db/**/*.js
db/**/*.js.map
desktop/db/**/*.js
desktop/db/**/*.js.map

# Pantheon / docs (conteúdo ignorado, exceto ADRs explicitamente versionados;
# docs/* em vez de docs/ para permitir a negação abaixo — git não
# re-inclui arquivo dentro de diretório excluído)
.pantheon/
docs/*
!docs/estimators-model.md
!docs/conventions.md
# Wiki in-app: markdown fonte compilado em build time pelo vite/plugins/markdownWikiPlugin.ts
# (precisa ser versionado — é a fonte do conteúdo, não artefato gerado).
!docs/wiki/
# Privacy specs (SPEC-01..04, ADRs, matrix): fontes normativas versionadas,
# base do gate de privacidade do app — tracked, nunca ignoradas (tracked-but-
# ignored quebra o stash interno do lint-staged).
!docs/privacy/
!docs/CREDITS.md

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Editor
.vscode/
.idea
.zcode/
test-models/
.DS_Store
*.sw?
*.local
.husky/_/

# Secrets / env
.env*
*.env
*.secret
*.pem

# Release notes automation — local backfill snapshots and generated output
release-notes-snapshots/
release-notes-output/


# v2.0 prototype — future launch, not part of the current build
Example/
